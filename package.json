{
  "name": "node-test-mocha-reporter",
  "version": "1.0.1",
  "description": "A custom reporter for the Node.js built-in test runner (node:test) that prints results like mocha's default spec reporter. Zero dependencies.",
  "type": "module",
  "exports": "./index.js",
  "files": [
    "index.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-reporter=./index.js 'index.test.js'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gordey4doronin/node-test-mocha-reporter.git"
  },
  "keywords": [
    "node:test",
    "node-test",
    "test-reporter",
    "reporter",
    "mocha",
    "spec"
  ],
  "author": "Gordey Doronin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gordey4doronin/node-test-mocha-reporter/issues"
  },
  "homepage": "https://github.com/gordey4doronin/node-test-mocha-reporter#readme"
}
